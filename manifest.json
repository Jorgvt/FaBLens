{
  "manifest_version": 3,
  "name": "FaB Lens",
  "version": "0.9.1",
  "description": "Recognize Flesh and Blood cards in YouTube and Twitch videos. Hover to preview cards and choose heroes for better matches.",
  "permissions": [
    "activeTab",
    "offscreen"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://www.twitch.tv/*"
      ],
      "js": [
        "hero-context.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/activation.png"
      ],
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://www.twitch.tv/*"
      ]
    }
  ],
  "action": {
    "default_title": "Enable / disable FaB Lens",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      }
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "minimum_chrome_version": "116",
  "options_ui": {
    "page": "help.html",
    "open_in_tab": true
  }
}
